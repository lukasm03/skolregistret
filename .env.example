# Copy this file to .env.local and fill in what you need.
#
# The app needs data/allt.json to build or run — it is not committed (200+MB,
# produced by a separate collector tool outside this repo). Nothing else here
# is required.


# --- Register data: an override, not a requirement -------------------------
#
# The app reads data/allt.json by default. Set this only to read a file from
# somewhere else. See registerFilePath() in src/lib/skolregister/client.ts.

# SKOLREGISTER_DATA_FILE=/absolute/path/to/some-other-allt.json

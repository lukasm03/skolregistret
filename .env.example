# Copy this file to .env.local and adjust. Both variables are read in
# src/lib/skolregister/client.ts and src/lib/skolregister/resources.ts.
#
# You need EITHER a running API server (option A) OR a local export file
# (option B). Option B is the easier one and works offline.


# --- Option A: live API -------------------------------------------------
#
# Base URL of the skolregister API. The app calls `${NEXT_PUBLIC_APP_URL}/api/skolor`,
# `/api/huvudman`, and the skolenhet/enkät/dokument endpoints under the same base.
#
# NOTE: this defaults to http://localhost:3000, which is also where `bun dev`
# serves THIS app — but this app has no route handlers of its own (there is no
# route.ts anywhere in src/app). So the default only works if a separate API
# server happens to be on port 3000. If you point a browser at the app and every
# list comes back empty, this is almost always why.

NEXT_PUBLIC_APP_URL=http://localhost:3000


# --- Option B: local register export (recommended for local dev) --------
#
# Absolute path to a register export JSON — the "exportera register" / "mitt
# register" download. When this is set it takes priority over the API for every
# read: skolor, huvudmän, school detail, enkäter and Skolinspektionen documents.
# The file is parsed once and cached for the lifetime of the process.
#
# Newer exports also carry nationelltGenomsnitt, nationelltProgramGenomsnitt,
# skolenkäterOchDokument and skoldetaljer. With an older export those sections
# are absent and the affected figures render as "saknas" rather than failing —
# see INGEN_FILDATA in src/lib/skolregister/resources.ts.
#
# Leave unset to use the API instead.

# SKOLREGISTER_DATA_FILE=/absolute/path/to/skolregister-export.json

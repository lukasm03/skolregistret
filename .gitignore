# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# collector output. data/koncern-lookup.json is NOT ignored — it is the built
# artefact export.ts reads, and it is small enough to keep in the repo.
/data/skolregister-export.json
/data/koncern-lager.json
/data/arsredovisningar/
/skolregister-*.json
/mitt-register.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# agent tooling session caches and local-only settings
/.impeccable/
/.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template is the only documentation of what those vars are.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
